# --- Backend Configuration ---

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moodtrip
DB_USERNAME=postgres
DB_PASSWORD=postgres
TZ=Europe/Berlin

# AI Provider (DeepSeek)
# REQUIRED: Get your key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Spotify Integration
# REQUIRED: Create an app at https://developer.spotify.com/dashboard/
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
reccobeats.base= https://api.reccobeats.com/v1/track/recommendation

# Security
# Change this to a strong random string in production
JWT_SECRET=change_me
JWT_EXPIRATION=60
JWT_ISSUER=moodtrip-backend

# --- Frontend Configuration ---

# Backend API URL
VITE_API_BASE_URL=http://localhost:8080

# Spotify Auth URL (Optional, defaults to backend endpoint)
VITE_SPOTIFY_AUTH_URL=http://localhost:8080/api/spotify/login
